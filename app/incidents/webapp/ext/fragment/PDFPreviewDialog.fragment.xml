<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <!--
        Native PDFViewer popup, following the pattern documented at
        https://ui5.sap.com/#/entity/sap.m.PDFViewer/sample/sap.m.sample.PDFViewerPopup
        The viewer opens its own dialog via .open() – no wrapping <Dialog>
        is needed. The controller handler wires the source at runtime.
    -->
    <PDFViewer
        id="pdfPreviewViewer"
        title="{pdfPreview>/fileName}"
        source="{pdfPreview>/source}"
        isTrustedSource="true"
        showDownloadButton="true"
        loaded=".onPDFLoaded"
        error=".onPDFError">
        <popupButtons>
            <Button
                id="pdfPreviewCloseButton"
                text="Close"
                press=".onClosePDFPreview" />
        </popupButtons>
    </PDFViewer>
</core:FragmentDefinition>
