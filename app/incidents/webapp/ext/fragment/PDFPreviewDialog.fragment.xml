<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog
        id="pdfPreviewDialog"
        title="{pdfPreview>/fileName}"
        contentWidth="80%"
        contentHeight="80%"
        stretch="{device>/system/phone}"
        resizable="true"
        draggable="true"
        busy="{pdfPreview>/busy}"
        busyIndicatorDelay="0">
        <content>
            <PDFViewer
                id="pdfViewer"
                width="100%"
                height="100%"
                isTrustedSource="true"
                showDownloadButton="true"
                displayType="Embedded"
                source="{pdfPreview>/source}"
                visible="{= !!${pdfPreview>/source} }"
                errorPlaceholderMessage="The PDF cannot be loaded. The file may be missing or unavailable." />
        </content>
        <beginButton>
            <Button
                id="pdfPreviewCloseButton"
                text="Close"
                press=".onClosePDFPreview" />
        </beginButton>
    </Dialog>
</core:FragmentDefinition>
